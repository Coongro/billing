{
  "id": "billing",
  "version": "0.1.0",
  "apiVersion": "2.0",
  "displayName": "Cobros",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Cobros",
        "order": 6,
        "icon": "assets/icons/receipt.svg",
        "color": "#0EA5E9"
      },
      {
        "path": "Cobros/Cuentas",
        "order": 1,
        "viewId": "billing.cobros.open"
      },
      {
        "path": "Cobros/Presupuestos",
        "order": 2,
        "viewId": "billing.presupuestos.open"
      },
      {
        "path": "Cobros/Deudores",
        "order": 3,
        "viewId": "billing.deudores.open"
      },
      {
        "path": "Cobros/Caja diaria",
        "order": 4,
        "viewId": "billing.caja.open"
      }
    ],
    "views": [
      {
        "id": "billing.cobros.open",
        "title": "Cuentas",
        "component": "./dist/views/cobros/index.js",
        "export": "CobrosView"
      },
      {
        "id": "billing.presupuestos.open",
        "title": "Presupuestos",
        "component": "./dist/views/presupuestos/index.js",
        "export": "PresupuestosView"
      },
      {
        "id": "billing.deudores.open",
        "title": "Deudores",
        "component": "./dist/views/deudores/index.js",
        "export": "DeudoresView"
      },
      {
        "id": "billing.caja.open",
        "title": "Caja diaria",
        "component": "./dist/views/caja/index.js",
        "export": "CajaView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/account.repository.js",
        "export": "AccountRepository",
        "prefix": "billing.accounts"
      },
      {
        "module": "./dist/repositories/account-line.repository.js",
        "export": "AccountLineRepository",
        "prefix": "billing.lines"
      },
      {
        "module": "./dist/repositories/payment.repository.js",
        "export": "PaymentRepository",
        "prefix": "billing.payments"
      }
    ]
  }
}

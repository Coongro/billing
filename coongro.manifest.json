{
  "id": "billing",
  "version": "0.1.0",
  "apiVersion": "2.0",
  "displayName": "Cobros",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Cobros",
        "order": 6,
        "icon": "assets/icons/receipt.svg",
        "color": "#0EA5E9",
        "viewId": "billing.cobros.open"
      }
    ],
    "views": [
      {
        "id": "billing.cobros.open",
        "title": "Cobros",
        "component": "./dist/views/cobros/index.js",
        "export": "CobrosView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/account.repository.js",
        "export": "AccountRepository",
        "prefix": "billing.accounts"
      },
      {
        "module": "./dist/repositories/account-line.repository.js",
        "export": "AccountLineRepository",
        "prefix": "billing.lines"
      }
    ]
  }
}

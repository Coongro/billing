{
  "id": "billing",
  "version": "0.2.0",
  "apiVersion": "2.0",
  "displayName": "Cobros",
  "assets": {
    "styles": [
      "./dist/assets/tailwind.css",
      "./dist/assets/fontawesome/css/all.min.css"
    ]
  },
  "contributes": {
    "menus": [
      {
        "path": "Cobros",
        "order": 6,
        "icon": "assets/icons/wallet.svg",
        "color": "#0EA5E9",
        "viewId": "billing.cobros.open"
      },
      {
        "path": "Caja",
        "order": 20,
        "icon": "assets/icons/coins.svg",
        "color": "#16A34A",
        "viewId": "billing.caja.open"
      }
    ],
    "views": [
      {
        "id": "billing.cobros.open",
        "title": "Cuentas",
        "component": "./dist/views/cobros/index.js",
        "export": "CobrosView"
      },
      {
        "id": "billing.deudores.open",
        "title": "Deudores",
        "component": "./dist/views/deudores/index.js",
        "export": "DeudoresView"
      },
      {
        "id": "billing.caja.open",
        "title": "Caja diaria",
        "component": "./dist/views/caja/index.js",
        "export": "CajaView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/account.repository.js",
        "export": "AccountRepository",
        "prefix": "billing.accounts"
      },
      {
        "module": "./dist/repositories/account-line.repository.js",
        "export": "AccountLineRepository",
        "prefix": "billing.lines"
      },
      {
        "module": "./dist/repositories/payment.repository.js",
        "export": "PaymentRepository",
        "prefix": "billing.payments"
      },
      {
        "module": "./dist/repositories/cash-close.repository.js",
        "export": "CashCloseRepository",
        "prefix": "billing.cashCloses"
      }
    ],
    "settings": {
      "groups": [{ "id": "billing", "label": "Cobros y caja", "order": 50 }],
      "pages": [
        {
          "id": "billing.general",
          "group": "billing",
          "label": "Caja",
          "icon": "assets/icons/wallet.svg",
          "order": 10
        },
        {
          "id": "billing.charging",
          "group": "billing",
          "label": "Cobros",
          "icon": "CreditCard",
          "order": 5
        }
      ],
      "sections": [
        {
          "id": "billing.general.cash",
          "page": "billing.general",
          "label": "Caja diaria",
          "order": 10,
          "items": [
            {
              "key": "billing.cash.openingFloat",
              "type": "number",
              "label": "Fondo inicial de caja",
              "description": "Efectivo con el que arranca el cajón cada día, para el arqueo. Se pre-rellena al cerrar la caja; podés ajustarlo ahí.",
              "default": 0,
              "min": 0,
              "tags": ["billing", "caja", "fondo", "inicial", "arqueo"]
            },
            {
              "key": "billing.cash.rounding",
              "type": "enum",
              "label": "Redondeo de efectivo",
              "description": "Al cobrar en efectivo, redondear el total para evitar vueltos con monedas. Solo afecta al efectivo; los medios digitales se cobran exactos.",
              "default": "off",
              "options": [
                { "value": "off", "label": "Sin redondeo" },
                { "value": "50", "label": "A $50" },
                { "value": "100", "label": "A $100" }
              ],
              "tags": ["billing", "cash", "rounding", "redondeo", "efectivo"]
            },
            {
              "key": "billing.cash.requireClose",
              "type": "boolean",
              "label": "Exigir arqueo diario",
              "description": "Pedir el cierre de caja (arqueo del efectivo) de cada día antes de poder operar el día siguiente. Útil para clínicas que controlan el efectivo a diario.",
              "default": false,
              "tags": [
                "billing",
                "cash",
                "requireclose",
                "exigir",
                "arqueo",
                "diario"
              ]
            }
          ]
        },
        {
          "id": "billing.charging.methods",
          "page": "billing.charging",
          "label": "Medios de pago",
          "order": 10,
          "items": [
            {
              "key": "billing.payments.transferencia",
              "type": "boolean",
              "label": "Aceptar transferencia",
              "description": "Ofrecer transferencia (CBU/CVU) como medio de cobro. Se acredita al instante y sin comisión.",
              "default": true,
              "tags": ["billing", "payments", "transferencia", "aceptar"]
            },
            {
              "key": "billing.payments.debito",
              "type": "boolean",
              "label": "Aceptar débito",
              "description": "Ofrecer tarjeta de débito como medio de cobro. Se acredita después, con comisión del posnet.",
              "default": true,
              "tags": ["billing", "payments", "debito", "aceptar", "débito"]
            },
            {
              "key": "billing.payments.credito",
              "type": "boolean",
              "label": "Aceptar crédito",
              "description": "Ofrecer tarjeta de crédito como medio de cobro. Podés cargarle un recargo automático más abajo.",
              "default": true,
              "tags": ["billing", "payments", "credito", "aceptar", "crédito"]
            }
          ]
        },
        {
          "id": "billing.charging.rules",
          "page": "billing.charging",
          "label": "Reglas de cobro",
          "order": 20,
          "items": [
            {
              "key": "billing.payments.creditSurcharge",
              "type": "number",
              "label": "Recargo por pago con crédito (%)",
              "description": "Porcentaje que se suma automáticamente al cobrar con tarjeta de crédito, para cubrir la comisión del posnet. Se agrega como una línea 'Recargo por crédito' en la cuenta. 0 = sin recargo.",
              "default": 0,
              "min": 0,
              "max": 100,
              "tags": [
                "billing",
                "payments",
                "creditsurcharge",
                "recargo",
                "pago",
                "crédito"
              ]
            },
            {
              "key": "billing.payments.onAccount",
              "type": "boolean",
              "label": "Permitir ventas a cuenta (fiado)",
              "description": "Dejar cuentas con saldo pendiente para cobrar después. Si lo apagás, cada cobro debe saldar el total y no se acumulan deudores.",
              "default": true,
              "tags": [
                "billing",
                "payments",
                "onaccount",
                "permitir",
                "ventas",
                "cuenta",
                "fiado"
              ]
            }
          ]
        }
      ]
    }
  }
}
